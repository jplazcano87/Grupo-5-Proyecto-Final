# Required
ANTHROPIC_API_KEY=
TMDB_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional
# Local SQLite is the default. For Turso: pip install ".[turso]" and use
# sqlite+libsql://<db>.turso.io?authToken=<token>&secure=true
# DATABASE_URL=sqlite:///plai.db
# ANTHROPIC_MODEL=claude-opus-5-5   # e.g. claude-sonnet-5-5 for a cheaper model
# ANTHROPIC_EFFORT=low              # low | medium | high | xhigh | max
# TMDB_REGION=CL
